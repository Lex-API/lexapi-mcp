{
  "name": "@lexapi/mcp",
  "version": "0.4.0",
  "mcpName": "io.github.Lex-API/lexapi-mcp",
  "description": "Model Context Protocol server for LexAPI — EUR-Lex legislation, CJEU case law, national law (as jurisdictions launch), the citation graph and semantic search (with point-in-time asOf) from Claude, Cursor and other MCP clients.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lexapi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "start": "node dist/index.js",
    "start:http": "node dist/http-entry.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lexapi",
    "eur-lex",
    "eu-law",
    "legal",
    "claude",
    "cjeu",
    "case-law",
    "semantic-search"
  ],
  "author": "Arieta Labs Ltd <support@lex-api.com> (https://lex-api.com)",
  "license": "MIT",
  "homepage": "https://lex-api.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lex-API/lexapi-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
